
# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_PASSWORD=change_me

# Local development (macOS)
DATABASE_URL=postgresql+asyncpg://taskhub:change_me@localhost:5433/taskhub_db

# Docker Compose (API container)
DOCKER_DATABASE_URL=postgresql+asyncpg://taskhub:change_me@db:5432/taskhub_db


# ==========================================
# Redis
# ==========================================

# Local development
REDIS_URL=redis://localhost:6379/0

# Docker Compose
DOCKER_REDIS_URL=redis://redis:6379/0


# ==========================================
# Test Environment
# ==========================================

# Separate PostgreSQL database for pytest
TEST_DATABASE_URL=postgresql+asyncpg://taskhub:change_me@localhost:5433/taskhub_test

# Separate Redis database for pytest
TEST_REDIS_URL=redis://localhost:6379/1


# ==========================================
# JWT Authentication
# ==========================================

# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256


# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO
