# PostgreSQL - chạy FastAPI trực tiếp trên Mac
DATABASE_URL=postgresql+asyncpg://taskhub:CHANGE_ME@localhost:5433/taskhub_db

# PostgreSQL - chạy FastAPI trong Docker Compose
DOCKER_DATABASE_URL=postgresql+asyncpg://taskhub:CHANGE_ME@db:5432/taskhub_db

# Mật khẩu dùng để khởi tạo PostgreSQL mới
POSTGRES_PASSWORD=CHANGE_ME

# Redis khi chạy FastAPI 
REDIS_URL=redis://localhost:6379/0

# Authentication / JWT
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Logging
LOG_LEVEL=INFO